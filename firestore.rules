rules_version = '2';

// Every Firestore read and write in this app goes through the Firebase Admin
// SDK on the server (route handlers + server components), which BYPASSES these
// rules entirely. The browser never touches Firestore directly.
//
// So: deny all client access as defense in depth. Membership applications and
// member billing records are the two collections here, and neither should ever
// be readable from a browser — an open rule on `members` would expose the
// roster and everyone's Stripe subscription state.
//
// If a future feature genuinely needs a direct client read (a public list
// rendered client-side, say), open that one path — never `/{document=**}`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
